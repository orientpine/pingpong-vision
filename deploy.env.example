# Settings for start.sh and install.sh. Copy to ~/.config/pingpong-vision/deploy.env
# (install.sh does it for you) and edit there. Never commit your copy.

# Local port of the app. The server listens on 127.0.0.1 only.
PORT=8791

# HTTPS port on your PC's Tailscale name. 443 gives https://<name>/vision/.
# Funnel allows only 443, 8443 and 10000.
FUNNEL_PORT=443

# serve  = only devices logged in to your tailnet can open it (recommended)
# funnel = anyone on the internet who has the link can open it
PPV_TS_MODE=serve

# Tournament app in tournament/. Its local port, and the address the camera app uses to check the
# PIN. Keep the two ports the same. Set PPV_TOURNAMENT_URL=off to run the camera app alone.
TOURNAMENT_PORT=8792
# The one local address bun run.mjs serves both apps on (macOS, Windows, or no systemd).
# start.sh does not use it: there Tailscale splits the paths itself.
APP_PORT=8780
PPV_TOURNAMENT_URL=http://127.0.0.1:8792

# Settings shows "New version" when the public repository has a newer release (asked at most once a
# day, nothing else is sent). off turns it off.
PPV_UPDATE_CHECK=on
